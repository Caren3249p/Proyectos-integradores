stateDiagram-v2
  [*] --> Abierta : POST /proyectos/{id}/versiones

  state Abierta {
    [*] --> SinArchivos
    SinArchivos --> ConArchivos : POST /versiones/{id}/archivos
    ConArchivos --> ConArchivos : Adjuntar archivo adicional
    ConArchivos --> SinArchivos : Eliminar último archivo
  }

  Abierta --> Finalizada : PATCH /versiones/{id}/final

  state Finalizada {
    [*] --> SoloLectura
    SoloLectura --> SoloLectura : GET /versiones/{id}
    SoloLectura --> SoloLectura : POST / DELETE / PUT rechazado
    note right of SoloLectura
      Las mutaciones se rechazan.
      La versión conserva es_final = true.
    end note
  }

  Finalizada --> [*] : Proyecto continúa su ciclo