@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam linetype ortho

' Actores oficiales UML
actor "Administrador" as Admin
actor "Estudiante" as Estudiante
actor "Docente" as Docente

rectangle "Plataforma PI UPB" {
  ' Casos de uso
  usecase "Gestión Global del Catálogo" as UC7
  usecase "Gestión de Ficha de Proyecto" as UC2
  usecase "Subida de Versiones y Archivos" as UC3
  usecase "Autenticación y Sesión" as UC1
  usecase "Consulta de Backlog Kanban" as UC4
  usecase "Diseño de Rúbricas Jerárquicas" as UC5
  usecase "Cálculo de Evaluación Bottom-Up" as UC6

  ' Relaciones Administrador con flecha hacia el caso de uso
  Admin -[hidden]- Estudiante
  Admin --> UC7
  Admin --> UC1

  ' Relaciones Estudiante con flecha hacia el caso de uso
  Estudiante -[hidden]- Docente
  Estudiante --> UC2
  Estudiante --> UC1
  Estudiante --> UC4
  UC3 .u.> UC2 : <<extend>>

  ' Relaciones Docente con flecha hacia el caso de uso
  Docente --> UC1
  Docente --> UC4
  Docente --> UC5
  Docente --> UC6
  UC6 .u.> UC5 : <<include>>
}
@enduml