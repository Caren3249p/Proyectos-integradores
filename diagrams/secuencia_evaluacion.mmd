sequenceDiagram
  autonumber
  actor D as Docente
  participant API as EvaluacionRouter
  participant C as EvaluacionController
  participant S as EvaluacionService
  participant DB as Prisma

  D->>API: POST /api/proyectos/{id}/evaluaciones
  activate API
  API->>C: crear(req, res)
  C->>S: crearEvaluacion(idProyecto, data, usuario)
  activate S

  S->>S: exigirDocente(usuario)
  S->>DB: exigirProyecto(idProyecto)
  DB-->>S: Proyecto
  S->>DB: findUnique(id_rubrica + criterios + niveles)
  activate DB
  DB-->>S: Rubrica con criterios
  deactivate DB

  S->>S: transformarPlanoAArbol()
  S->>S: validar hojas calificables
  S->>S: calcularNotaFinal Bottom-Up
  S->>DB: $transaction(create Evaluacion + Calificaciones)
  activate DB
  alt Transacción Exitosa
    DB-->>S: Evaluación guardada
    S-->>C: Evaluación + nota_final
    C-->>API: HTTP 201 JSON
    API-->>D: 201 Created
  else Validación o integridad inválida
    DB-->>S: Error
    S-->>C: errorConEstado()
    C-->>API: HTTP 400 / 403 / 404
    API-->>D: Error JSON
  end
  deactivate DB
  deactivate S
  deactivate API